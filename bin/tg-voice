#!/bin/bash
# tg-voice — vocali Telegram via Bot API, per i bot che non hanno un bridge che lo fa.
#   tg-voice get <file_id>            scarica il vocale e lo trascrive (testo su stdout)
#   tg-voice send <chat_id> <file.ogg> manda un OGG/Opus come vocale
# Token: TG_TOKEN_FILE, un file che contiene solo il token del bot.
set -euo pipefail
V=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[ -f "$V/voice.env" ] && . "$V/voice.env"
: "${TG_TOKEN_FILE:?TG_TOKEN_FILE non impostato}"
api="https://api.telegram.org"; tok=$(<"$TG_TOKEN_FILE")
case "${1:-}" in
  get)
    path=$(curl -fsS "$api/bot$tok/getFile?file_id=$2" | jq -er .result.file_path)
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    curl -fsS -o "$tmp/voice.oga" "$api/file/bot$tok/$path"
    "$V/bin/stt" "$tmp/voice.oga" ;;
  send)
    curl -fsS -F "chat_id=$2" -F "voice=@$3" "$api/bot$tok/sendVoice" \
      | jq -er '"sent id=\(.result.message_id)"' ;;
  *) sed -n '2,5s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
