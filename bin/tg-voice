#!/bin/bash
# tg-voice — Telegram voice notes over the Bot API, for bots without a bridge doing it.
#   tg-voice get <file_id>            download the voice note and transcribe it (text on stdout)
#   tg-voice send <chat_id> <file.ogg> send an OGG/Opus as a voice note
# Token: TG_TOKEN_FILE, a file holding only the bot token.
set -euo pipefail
V=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[ -f "$V/voice.env" ] && . "$V/voice.env"
: "${TG_TOKEN_FILE:?TG_TOKEN_FILE not set}"
api="https://api.telegram.org"; tok=$(<"$TG_TOKEN_FILE")
case "${1:-}" in
  get)
    path=$(curl -fsS "$api/bot$tok/getFile?file_id=$2" | jq -er .result.file_path)
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    curl -fsS -o "$tmp/voice.oga" "$api/file/bot$tok/$path"
    "$V/bin/stt" "$tmp/voice.oga" ;;
  send)
    curl -fsS -F "chat_id=$2" -F "voice=@$3" "$api/bot$tok/sendVoice" \
      | jq -er '"sent id=\(.result.message_id)"' ;;
  *) sed -n '2,5s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
